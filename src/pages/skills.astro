---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkillRow from '../components/SkillRow.astro';

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
// The five claims of the home-page sentence, in its order, each with what it means here.
const PHRASES = [
  { key: 'ai', label: 'AI on robots', intro: 'Language and vision models that run on a machine, and the robot software, control, and hardware around them.' },
  { key: 'platforms', label: 'The platforms a business runs on', intro: 'Software that real people use every day, built end to end and handed over with tests and documentation.' },
  { key: 'operations', label: 'Operations', intro: 'Six years of industrial and production engineering, and enough of the textile floor to know what a factory needs.' },
  { key: 'supply', label: 'Supply chains', intro: 'How goods and money move, from five graduate-level courses, and the analytics to work with the data.' },
  { key: 'people', label: 'The people who have to use them', intro: 'Explaining things, running things, and the languages I do it in.' },
  { key: 'other', label: 'Also', intro: 'Fields I studied to working level that the sentence does not claim.' },
] as const;
---

<Base title="Skills" description="What Mohammad Shoaib can do, each group with the work that proves it, arranged under the five claims of the home page.">
  <header class="page-head">
    <p class="page-head__span">With proof</p>
    <h1>Skills, with proof</h1>
    <p class="page-head__lead">The sentence on the home page makes five claims. This page is the evidence for each, group by group, with the tools named. If there is no proof, it is not listed.</p>
    <nav class="phrases" aria-label="The five claims">
      {PHRASES.filter((p) => p.key !== 'other').map((p) => (<a href={`#${p.key}`}>{p.label}</a>))}
    </nav>
  </header>

  {PHRASES.map((p) => {
    const mine = skills.filter((s) => s.data.phrase === p.key);
    if (!mine.length) return null;
    return (
      <section class="section" aria-labelledby={p.key} id={p.key}>
        <h2 id={`${p.key}-label`} class="section__label">{p.label}</h2>
        <p class="phrase__intro">{p.intro}</p>
        <div class="skills">
          {mine.map((s) => <SkillRow skill={s} headingLevel="h3" />)}
        </div>
      </section>
    );
  })}
</Base>
