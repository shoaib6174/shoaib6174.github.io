---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkillGrid from '../components/SkillGrid.astro';

const groups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const PLACE_NAMES: Record<string, string> = {
  butex: 'BUTEX', mitx: 'MITx', microsoft: 'Microsoft', deeppavlov: 'DeepPavlov', gsoc: 'Google Summer of Code',
  quantum: 'the quantum year', nsu: 'NSU', nitex: 'NITEX', lab: 'the lab', fenloai: 'FenloAI', writing: 'writing', own: 'my own time',
};
const setAside = [
  { what: 'Frontend work', when: '2020', why: 'Finished a web development bootcamp and found I did not enjoy it.', href: '/route/2020-take-it-seriously/' },
  { what: 'DevOps as a career', when: '2020', why: 'Finished a cloud specialisation because DevOps was in demand; finishing it told me it was not for me.', href: '/route/2020-take-it-seriously/' },
  { what: 'Theoretical research', when: '2023', why: 'One semester on a quantum track. Learning it was the best part; I wanted to build systems.', href: '/route/2023-nsu-msc/' },
];
---

<Base title="Skills" description="What Mohammad Shoaib can do, as a grid of skills against the places they were used, every mark a link to the proof." wide>
  <header class="page-head">
    <p class="page-head__span">With proof</p>
    <h1>Skills, with proof</h1>
    <p class="page-head__lead">Five groups, in order of how much work sits behind them. Across the top, the places I have worked and studied, in the order I reached them. A mark is a skill used at a place, and every mark links to the thing that proves it. Depth is the count.</p>
  </header>

  <SkillGrid groups={groups} />

  {groups.map((g) => (
    <section class="section" id={g.id} aria-labelledby={`${g.id}-label`}>
      <h2 id={`${g.id}-label`} class="section__label">{g.data.group}</h2>
      <p class="phrase__intro">{g.data.claim}</p>
      <ul class="slines">
        {g.data.skills.map((s) => (
          <li class="sline" id={`${g.id}-${s.id}`}>
            <p class="sline__head"><strong>{s.name}.</strong> Since {s.since}. {s.marks.map((m, i) => (<><a href={m.href}>{m.label}</a>{i < s.marks.length - 1 ? '; ' : '.'}</>))}</p>
            <p class="sline__tools">{s.tools}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="section" id="set-aside" aria-labelledby="set-aside-label">
    <h2 id="set-aside-label" class="section__label">Tried, and set aside</h2>
    <p class="phrase__intro">So the list above is not inflated.</p>
    <ul class="slines">
      {setAside.map((x) => (
        <li class="sline"><p class="sline__head"><strong>{x.what}.</strong> {x.when}. {x.why} <a href={x.href}>The entry</a>.</p></li>
      ))}
    </ul>
  </section>
</Base>
