---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { frontmatter as home } from '../content/home.md';
import headshot from '../assets/photos/headshot.jpeg';
import { formatDate, sortKey } from '../lib/dates';

const layers = (await getCollection('layers')).sort((a, b) => a.data.order - b.data.order);
const route = (await getCollection('journey', ({ data }) => data.onRoute)).sort(
  (a, b) => sortKey(a.data.date) - sortKey(b.data.date),
);
const work = (await getCollection('work', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const statusWord: Record<string, string> = { built: 'built', applied: 'applied', studied: 'studied' };
---

<Base title="Mohammad Shoaib" description={home.masthead} bodyClass="home">
  <section class="who" aria-labelledby="name">
    <Image class="who__photo" src={headshot} alt="Mohammad Shoaib" width="224" height="280" densities={[1, 2]} />
    <h1 id="name" class="who__name">{home.name}</h1>
    <div class="who__statement">
      {home.statement.map((line: string, i: number) => (
        <p class:list={{ 'who__claim': i === home.statement.length - 1 }}>{line}</p>
      ))}
    </div>
  </section>

  <section class="stack" aria-labelledby="stack-h" data-stack>
    <h2 id="stack-h" class="stack__label">From the floor to the customer</h2>
    <p class="stack__intro">A problem in the physical world passes through seven layers on its way to a customer. I have built in five of them, I design for one, and I have studied one without building in it yet.</p>
    <ol class="stack__list">
      {layers.map((l, i) => (
        <li class:list={['stage', `is-${l.data.status}`]} style={`--i:${i}`}>
          <div class="stage__m">
            <span class="stage__status">{statusWord[l.data.status]}</span>
          </div>
          <div class="stage__body">
            <h3 class="stage__name">{l.data.layer}</h3>
            <p class="stage__bring">{l.data.bring}</p>
            <p class="stage__proof">
              {l.data.proof.map((p, j) => (<><a href={p.href}>{p.label}</a>{j < l.data.proof.length - 1 ? ', ' : ''}</>))}
            </p>
          </div>
        </li>
      ))}
    </ol>
    <p class="stack__more"><a href="/skills/">Every skill, with proof</a></p>
  </section>

  <section class="section" aria-labelledby="roles">
    <h2 id="roles" class="section__label">Three things I do</h2>
    <div class="roles" data-roles>
      {home.roles.map((r: { key: string; title: string; text: string }) => (
        <div class="role" data-role={r.key}>
          <h3 class="role__title">{r.title}</h3>
          <p class="role__text">{r.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="now">
    <h2 id="now" class="section__label">Now</h2>
    <ul class="now">
      {home.now.map((n: string) => <li>{n}</li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="route">
    <h2 id="route" class="section__label">How I got here</h2>
    <ol class="route">
      {route.map((e) => (
        <li>
          <time datetime={e.data.date}>{formatDate(e.data.date)}</time>
          <a href={`/route/#${e.id}`}>{e.data.title}</a>
        </li>
      ))}
    </ol>
    <p class="cta"><a href="/route/">Read the route</a><span>What I did, in order, and why. 2014 to now.</span></p>
  </section>

  <section class="section" aria-labelledby="work-h">
    <h2 id="work-h" class="section__label">Work</h2>
    <ul class="worklinks">
      {work.map((w) => (
        <li><a href={`/work/${w.id}/`}>{w.data.title}</a><span>{w.data.summary}</span></li>
      ))}
    </ul>
    <p class="section__more"><a href="/work/">All work</a></p>
  </section>

  <script src="../scripts/roles.ts"></script>
  <script src="../scripts/stack.ts"></script>
</Base>
