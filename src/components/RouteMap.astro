---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/dates';

interface Props { entries: CollectionEntry<'journey'>[] }
const { entries } = Astro.props;

// One line through every entry, in order. Stations are evenly spaced, like a transit map:
// the order is exact, the distances are not. The row says what kind of thing it was.
const THREADS = [
  { key: 'build', label: 'Built' },
  { key: 'explain', label: 'Wrote' },
  { key: 'organise', label: 'Organised' },
  { key: 'studied', label: 'Studied' },
  { key: 'life', label: 'Life' },
];
const W = 1000;
const LEFT = 118;
const RIGHT = 960;
const TOP = 26;
const ROW = 54;
const H = TOP + THREADS.length * ROW + 30;
const n = entries.length;
const STEP = (RIGHT - LEFT) / (n - 1);
const laneY = (key: string) => TOP + THREADS.findIndex((t) => t.key === key) * ROW + ROW / 2;
const stations = entries.map((e, i) => ({
  id: e.id,
  i,
  x: LEFT + i * STEP,
  y: laneY(e.data.threads[0]),
  label: e.data.short,
  title: e.data.title,
  date: formatDate(e.data.date),
  year: e.data.date.slice(0, 4),
  threads: e.data.threads.join(' '),
  seg: '',
}));
// Transit-map geometry: a horizontal run, a rounded corner, a vertical link, a corner, a run.
for (let i = 1; i < n; i++) {
  const a = stations[i - 1];
  const b = stations[i];
  if (a.y === b.y) { stations[i].seg = `L${b.x},${b.y}`; continue; }
  const xm = (a.x + b.x) / 2;
  const down = b.y > a.y;
  const r = Math.min(11, STEP / 2 - 6, Math.abs(b.y - a.y) / 2);
  const s1 = down ? 1 : 0;
  const s2 = down ? 0 : 1;
  const y1 = down ? a.y + r : a.y - r;
  const y2 = down ? b.y - r : b.y + r;
  stations[i].seg = `L${xm - r},${a.y} A${r},${r} 0 0 ${s1} ${xm},${y1} L${xm},${y2} A${r},${r} 0 0 ${s2} ${xm + r},${b.y} L${b.x},${b.y}`;
}
const d = `M${stations[0].x},${stations[0].y} ` + stations.slice(1).map((s) => s.seg).join(' ');
const yearMarks = stations.filter((s, i) => i === 0 || stations[i - 1].year !== s.year);
// Labels alternate above and below when two labelled stations sit next to each other in one row.
const labelled = stations.filter((s) => s.label);
const below = new Set<string>();
labelled.forEach((s, k) => {
  const prev = [...labelled.slice(0, k)].reverse().find((o) => o.y === s.y);
  if (prev && s.x - prev.x < 90 && !below.has(prev.id)) below.add(s.id);
});
---

<figure class="rmap" data-rmap>
  <svg class="rmap__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="rmap-title rmap-desc">
    <title id="rmap-title">The route as one line, 2012 to now, station by station</title>
    <desc id="rmap-desc">One line runs through every entry in order. Its row says what kind of thing the entry was: built, wrote, organised, studied, or life. A marker travels the line and names each station as it passes. Point at a station to pause, or follow it to the entry.</desc>
    <g class="rmap__years" aria-hidden="true">
      {yearMarks.map((s) => (
        <g>
          <line x1={s.x - STEP / 2} x2={s.x - STEP / 2} y1={H - 30} y2={H - 22} />
          <text x={s.x - STEP / 2 + 5} y={H - 9}>{s.year}</text>
        </g>
      ))}
    </g>
    <g class="rmap__lanes">
      {THREADS.map((t, i) => (
        <g class="rmap__lane" data-thread={t.key}>
          <rect x={LEFT - 18} y={laneY(t.key) - ROW / 2} width={RIGHT - LEFT + 36} height={ROW} rx="6" class:list={{ 'is-alt': i % 2 === 1 }} />
          <text x={LEFT - 28} y={laneY(t.key) + 6} text-anchor="end" class="rmap__lanelabel">{t.label}</text>
        </g>
      ))}
    </g>
    <path class="rmap__line" d={d} />
    <path class="rmap__trail" d={d} data-trail />
    <g class="rmap__stations">
      {stations.map((s) => (
        <a href={`#${s.id}`} class="rmap__dot" data-entry={s.id} data-threads={s.threads} data-seg={s.seg} data-x={s.x} data-y={s.y} data-title={`${s.date}. ${s.title}`}>
          <circle class="rmap__halo" cx={s.x} cy={s.y} r="14" />
          <circle class="rmap__station" cx={s.x} cy={s.y} r={s.label ? 8 : 6} />
          {s.label && (
            <text x={s.i === n - 1 ? s.x + 16 : s.x} y={s.i === n - 1 ? s.y + 6 : below.has(s.id) ? s.y + 30 : s.y - 17} text-anchor={s.i === n - 1 ? 'start' : 'middle'} class="rmap__label">{s.label}</text>
          )}
          <title>{s.date}. {s.title}</title>
        </a>
      ))}
    </g>
    <g class="rmap__traveller" data-traveller aria-hidden="true">
      <circle r="13" class="rmap__pulse" />
      <circle r="7" class="rmap__rider" />
    </g>
    <g class="rmap__tag" data-tag aria-hidden="true">
      <rect rx="5" ry="5" />
      <text />
    </g>
  </svg>
  <figcaption class="rmap__caption">In order, 2012 to now. The marker stops at each milestone. Point at one to hold it, or follow it to the entry.</figcaption>
</figure>

<script>
  // The traveller runs the whole route on a loop. It arrives at a station, stops, and the
  // station's name appears on it; then it moves on. Hovering a station holds it there.
  let controller: AbortController | null = null;
  function init() {
    controller?.abort();
    controller = null;
    const root = document.querySelector<HTMLElement>('[data-rmap]');
    if (!root) return;
    controller = new AbortController();
    const { signal } = controller;
    const svg = root.querySelector<SVGSVGElement>('svg')!;
    const trail = root.querySelector<SVGPathElement>('[data-trail]')!;
    const traveller = root.querySelector<SVGGElement>('[data-traveller]')!;
    const tag = root.querySelector<SVGGElement>('[data-tag]')!;
    const tagRect = tag.querySelector('rect')!;
    const tagText = tag.querySelector('text')!;
    const stations = [...root.querySelectorAll<SVGAElement>('.rmap__dot')];
    const n = stations.length;
    const W = svg.viewBox.baseVal.width;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Distance along the line at which each station sits.
    const NS = 'http://www.w3.org/2000/svg';
    const probe = document.createElementNS(NS, 'path');
    let dAcc = `M${stations[0].dataset.x},${stations[0].dataset.y}`;
    const at = stations.map((s, i) => {
      if (i > 0) dAcc += ' ' + s.dataset.seg;
      probe.setAttribute('d', dAcc);
      return probe.getTotalLength();
    });
    const L = trail.getTotalLength();
    trail.style.strokeDasharray = String(L);

    const showTag = (k: number) => {
      const s = stations[k];
      const x = Number(s.dataset.x);
      const y = Number(s.dataset.y);
      tagText.textContent = s.dataset.title ?? '';
      const box = tagText.getBBox();
      const padX = 10;
      const w = box.width + padX * 2;
      const h = box.height + 10;
      const label = s.querySelector('.rmap__label');
      const labelAbove = label ? Number(label.getAttribute('y')) < y : false;
      const toRight = x < W / 2;
      const rx = toRight ? x - 14 : x + 14 - w;
      const bottomRow = y > svg.viewBox.baseVal.height - 70;
      const ry = labelAbove && !bottomRow ? y + 18 : y - 18 - h;
      tagRect.setAttribute('x', String(rx));
      tagRect.setAttribute('y', String(ry));
      tagRect.setAttribute('width', String(w));
      tagRect.setAttribute('height', String(h));
      tagText.setAttribute('x', String(rx + padX));
      tagText.setAttribute('y', String(ry + h / 2 + box.height * 0.36));
      tag.classList.add('is-on');
    };
    const place = (len: number, here: number) => {
      const p = trail.getPointAtLength(len);
      traveller.setAttribute('transform', `translate(${p.x} ${p.y})`);
      trail.style.strokeDashoffset = String(L - len);
      stations.forEach((s, i) => {
        s.classList.toggle('is-lit', i < here);
        s.classList.toggle('is-here', i === here);
      });
    };

    if (reduced) {
      trail.style.strokeDashoffset = '0';
      place(L, n - 1);
      stations.forEach((s) => s.classList.add('is-lit'));
      showTag(n - 1);
      return;
    }

    // Schedule: stop at a station, then move to the next, with a hold at the end.
    const T_STOP = 900;
    const T_MOVE = 650;
    const HOLD = 2200;
    const unit = T_STOP + T_MOVE;
    const period = (n - 1) * unit + T_STOP + HOLD;
    const ease = (u: number) => (u < 0.5 ? 2 * u * u : 1 - ((-2 * u + 2) ** 2) / 2);
    let paused = false;
    let visible = true;
    let last = performance.now();
    let elapsed = 0;
    let shown = -1;
    let raf = 0;
    const tick = (now: number) => {
      // A frame's timestamp can precede the moment the loop was armed; never run backwards.
      if (!paused && visible) elapsed = Math.max(0, elapsed + (now - last));
      last = now;
      if (!paused) {
        const cycle = elapsed % period;
        const k = Math.min(Math.floor(cycle / unit), n - 1);
        const into = cycle - k * unit;
        let len = at[k];
        if (k < n - 1 && into > T_STOP) len = at[k] + (at[k + 1] - at[k]) * ease((into - T_STOP) / T_MOVE);
        place(len, k);
        if (k !== shown) { shown = k; showTag(k); }
      }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    signal.addEventListener('abort', () => cancelAnimationFrame(raf));
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; });
    io.observe(root);
    signal.addEventListener('abort', () => io.disconnect());
    stations.forEach((s, i) => {
      const hold = () => { paused = true; place(at[i], i); showTag(i); shown = i; };
      const release = () => { paused = false; };
      s.addEventListener('pointerenter', hold, { signal });
      s.addEventListener('pointerleave', release, { signal });
      s.addEventListener('focus', hold, { signal });
      s.addEventListener('blur', release, { signal });
    });
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>
