---
import map from '../content/map.json';

const W = 1000;
const H = 620;
const byId = Object.fromEntries(map.nodes.map((n) => [n.id, n]));
const degree: Record<string, number> = {};
for (const e of map.edges) {
  degree[e.from] = (degree[e.from] ?? 0) + 1;
  degree[e.to] = (degree[e.to] ?? 0) + 1;
}
const anchor = (n: { x: number }) => (n.x < 230 ? 'start' : n.x > 770 ? 'end' : 'middle');
const labelY = (n: { y: number }) => (n.y < 120 ? n.y - 18 : n.y + 26);
---

<figure class="map" data-map>
  <svg class="map__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">Thirteen fields, and the work that joined them</title>
    <desc id="map-desc">Each line between two fields is one project. Hover or focus a field to see its projects.</desc>
    <g class="map__edges">
      {map.edges.map((e) => {
        const a = byId[e.from];
        const b = byId[e.to];
        return (
          <line
            x1={a.x} y1={a.y} x2={b.x} y2={b.y}
            data-from={e.from} data-to={e.to} data-label={e.label} data-href={e.href}
          />
        );
      })}
    </g>
    <g class="map__nodes">
      {map.nodes.map((n) => (
        <a href={n.href} data-node={n.id} class:list={['map__node', { 'is-isolated': !degree[n.id] }]}>
          <circle cx={n.x} cy={n.y} r={degree[n.id] ? 7 + Math.min(degree[n.id], 5) * 1.5 : 6} />
          <text x={n.x} y={labelY(n)} text-anchor={anchor(n)}>{n.label}</text>
        </a>
      ))}
    </g>
  </svg>
  <figcaption class="map__caption" data-map-caption aria-live="polite">
    Each line is one piece of work that joined two fields. Point at a field to see which. A field with no line is one I have studied but not yet built in.
  </figcaption>
  <ul class="visually-hidden">
    {map.edges.map((e) => (
      <li>{byId[e.from].label} and {byId[e.to].label}: <a href={e.href}>{e.label}</a></li>
    ))}
  </ul>
</figure>

<script>
  let controller: AbortController | null = null;
  function init() {
    controller?.abort();
    controller = null;
    const root = document.querySelector<HTMLElement>('[data-map]');
    if (!root) return;
    controller = new AbortController();
    const { signal } = controller;
    const nodes = [...root.querySelectorAll<SVGElement>('[data-node]')];
    const edges = [...root.querySelectorAll<SVGLineElement>('line[data-from]')];
    const caption = root.querySelector<HTMLElement>('[data-map-caption]')!;
    const idle = caption.textContent;
    const labelOf = (id: string) => root.querySelector(`[data-node="${id}"] text`)?.textContent ?? id;

    const focus = (id: string | null) => {
      root.classList.toggle('is-focused', id !== null);
      const hot = new Set<string>();
      edges.forEach((e) => {
        const on = id !== null && (e.dataset.from === id || e.dataset.to === id);
        e.classList.toggle('is-hot', on);
        if (on) { hot.add(e.dataset.from!); hot.add(e.dataset.to!); }
      });
      nodes.forEach((n) => n.classList.toggle('is-hot', id !== null && hot.has(n.dataset.node!)));
      if (id === null) { caption.textContent = idle; return; }
      const mine = edges.filter((e) => e.dataset.from === id || e.dataset.to === id);
      if (!mine.length) { caption.textContent = `${labelOf(id)}: studied, not yet built in.`; return; }
      caption.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = labelOf(id);
      caption.append(strong, ': ');
      mine.forEach((e, i) => {
        const other = e.dataset.from === id ? e.dataset.to! : e.dataset.from!;
        const a = document.createElement('a');
        a.href = e.dataset.href!;
        a.textContent = e.dataset.label!;
        const span = document.createElement('span');
        span.textContent = ` with ${labelOf(other)}`;
        caption.append(a, span, i < mine.length - 1 ? '; ' : '.');
      });
    };
    nodes.forEach((n) => {
      n.addEventListener('pointerenter', () => focus(n.dataset.node!), { signal });
      n.addEventListener('pointerleave', () => focus(null), { signal });
      n.addEventListener('focus', () => focus(n.dataset.node!), { signal });
      n.addEventListener('blur', () => focus(null), { signal });
    });
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>
