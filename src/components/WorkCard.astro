---
import type { CollectionEntry } from 'astro:content';
import StatusTag from './StatusTag.astro';

interface Props {
  item: CollectionEntry<'work'>;
  compact?: boolean;
}
const { item, compact = false } = Astro.props;
const d = item.data;
---

<article class="row" data-area={d.area} data-role={d.role}>
  <p class="row__years">{d.years}</p>
  <div class="row__body">
    <h3 class="row__title"><a href={`/work/${item.id}/`}>{d.title}</a></h3>
    <p class="row__summary">{d.summary}</p>
    {!compact && <p class="row__why">{d.why}</p>}
    <div class="row__foot">
      <StatusTag status={d.status} />
      <ul>
        {d.links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</article>
