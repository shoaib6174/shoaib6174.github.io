---
import type { CollectionEntry } from 'astro:content';
import StatusTag from './StatusTag.astro';

interface Props {
  item: CollectionEntry<'work'>;
  compact?: boolean;
}
const { item, compact = false } = Astro.props;
const d = item.data;
---

<article class:list={['card', { 'card--compact': compact }]} data-area={d.area} data-role={d.role}>
  <div class="card__head">
    <span class="card__years">{d.years}</span>
    <StatusTag status={d.status} />
  </div>
  <h3 class="card__title"><a href={`/work/${item.id}/`}>{d.title}</a></h3>
  <p class="card__summary">{d.summary}</p>
  {!compact && <p class="card__why">{d.why}</p>}
  <ul class="card__links">
    {d.links.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
</article>
