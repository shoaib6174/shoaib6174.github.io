---
import type { CollectionEntry } from 'astro:content';

interface Props {
  skill: CollectionEntry<'skills'>;
  headingLevel?: 'h2' | 'h3';
}
const { skill, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const d = skill.data;
---

<div class="skill" id={`skill-${skill.id}`}>
  <H class="skill__group">{d.group}</H>
  <p class="skill__tools">{d.tools.join(', ')}</p>
  <p class="skill__proof">
    <span class="skill__proof-label">Proof</span>
    {d.proof.map((p, i) => (
      <>
        <a href={p.href}>{p.label}</a>{i < d.proof.length - 1 ? ', ' : ''}
      </>
    ))}
  </p>
</div>
